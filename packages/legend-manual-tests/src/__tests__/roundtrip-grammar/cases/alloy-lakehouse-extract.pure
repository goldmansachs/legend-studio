// Organizational Scope ----- START

Class meta::external::extract::specification::protocol::organization::Owner
{
}

Class meta::external::extract::specification::protocol::organization::AppDir extends meta::external::extract::specification::protocol::organization::Owner
[
  OneAppDir(
    ~function : $this.prodParallel->isNotEmpty() || $this.production->isNotEmpty()
    ~message : 'When defining an owner of type AppDir, you have to specify, at a minimum, one of a production or a prodParallel AppDirNode.'
  )
]
{
  prodParallel : meta::external::extract::specification::protocol::organization::AppDirNode[0..1];
  production : meta::external::extract::specification::protocol::organization::AppDirNode[0..1];
}

Class meta::external::extract::specification::protocol::organization::AppDirNode
[
    DeploymentIdOnly(
    ~function : $this.level == AppDirLevel.DEPLOYMENT
    ~message : 'Only AppDir deployment id is allowed to be specified'
  )
]
{
  appDirId: Integer[1];
  level: AppDirLevel[1];
}

Enum meta::external::extract::specification::protocol::organization::AppDirLevel
{
  BUSINESS_UNIT,
  SUB_BUSINESS_UNIT,
  FAMILY,
  APPLICATION,
  DEPLOYMENT
}

// Organizational Scope ----- END

